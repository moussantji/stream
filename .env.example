APP_NAME="MovieBox Stream"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Default is SQLite for zero-config local dev. Switch to mysql/pgsql for production.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=moviebox
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Sanctum: comma separated list of SPA domains that receive stateful cookies.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# ---------------------------------------------------------------------------
# MovieBox (aoneroom) mobile API configuration
# ---------------------------------------------------------------------------
# Comma-separated pool of signed mobile-API hosts (tried in order w/ failover).
MOVIEBOX_HOST_POOL="https://api6.aoneroom.com,https://api5.aoneroom.com,https://api4.aoneroom.com,https://api4sg.aoneroom.com,https://api3.aoneroom.com,https://api6sg.aoneroom.com,https://api.inmoviebox.com"
# How long (seconds) to cache the bootstrapped bearer token.
MOVIEBOX_TOKEN_TTL=1800
# How long (seconds) to cache catalog responses (home/search/detail).
MOVIEBOX_CACHE_TTL=300
# How long (seconds) a MySQL snapshot is served as fresh before re-fetching
# (still used as a fallback beyond this when the API fails).
MOVIEBOX_SNAPSHOT_TTL=900
# Persist every movie/series received into the catalog_items table.
MOVIEBOX_PERSIST_ITEMS=true
# Outbound request timeout in seconds.
MOVIEBOX_TIMEOUT=30
# The MovieBox API has no language filter (its landing page is Bollywood-heavy),
# so the home page is built from these search queries instead. Comma-separated,
# each "Row label|search query". Set empty to use the provider's landing page.
MOVIEBOX_HOME_QUERIES="Films en français|film français,Version française|version française,Comédie|comédie française,Action|action française,Séries en français|série française,Animation|animation française"
# Query backing the "Trending" row/page.
MOVIEBOX_TRENDING_QUERY=français
# Region/language identity (informational only; the API ignores it for content).
MOVIEBOX_REGION=FR
MOVIEBOX_LANGUAGE=fr
MOVIEBOX_TIMEZONE=Europe/Paris
# Optional HTTP(S) proxy for outbound requests, e.g. http://user:pass@host:port
MOVIEBOX_PROXY=
# HMAC signing secret (base64). Only change if the upstream rotates it.
# MOVIEBOX_SECRET_KEY=
